# Firebase client configuration
NEXT_PUBLIC_FIREBASE_API_KEY=replace_with_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace_with_firebase_project_id

# Server-only OpenAI configuration for screenshot analysis
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_VISION_MODEL=gpt-5.6-luna

# Server-only support mailer configuration
RESEND_API_KEY=replace_with_resend_api_key
SUPPORT_EMAIL_TO=replace_with_private_support_address
SUPPORT_EMAIL_FROM="Enginn <support@your_verified_domain.example>"

# Server-only Strava OAuth configuration
STRAVA_CLIENT_ID=replace_with_strava_client_id
STRAVA_CLIENT_SECRET=replace_with_strava_client_secret
# Optional. When omitted, Enginn uses the current origin + /api/strava/callback.
# For production use the callback URL registered for enginn.app.
STRAVA_REDIRECT_URI=https://enginn.app/api/strava/callback
